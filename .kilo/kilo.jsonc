{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "anthropic/claude-sonnet-4",
  "small_model": "anthropic/claude-sonnet-4",
  "default_agent": "code",
  "instructions": ["AGENTS.md", "CLAUDE.md", "CONTEXT.md", ".kilo/**/*.md"],
  "plugin": [],
  "snapshot": true,
  "share": "manual",
  "autoupdate": "notify",
  "compaction": {
    "auto": true,
    "prune": true,
  },
  "permission": {
    "bash": "allow",
    "edit": {
      "src/**": "allow",
      ".env.*": "deny",
      "*.key": "deny",
      "*.pem": "deny",
      "node_modules/**": "deny",
      "dist/**": "deny",
      "*": "ask",
    },
    "read": "allow",
    "skill": "allow",
    "external_directory": "allow",
  },
  "provider": {
    "anthropic": {
      "options": {
        "timeout": 300000,
      },
    },
  },
  "mcp": {
    "agentmemory": {
      "type": "local",
      "command": ["npx", "-y", "@agentmemory/mcp"],
      "enabled": true,
      "environment": {
        "AGENTMEMORY_URL": "http://localhost:49134",
      },
    },
  },
  "skills": {
    "paths": [".kilo/skills", ".kilocode/skills", ".opencode/skills"],
  },
}
